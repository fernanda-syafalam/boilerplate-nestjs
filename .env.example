# Copy to .env for local development; never commit real secrets. Full list: src/config/env.schema.ts.
NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://app:app@localhost:5432/app
DATABASE_POOL_SIZE=10

REDIS_URL=redis://localhost:6379

THROTTLER_TTL_MS=60000
THROTTLER_LIMIT=100

# At least 32 characters; generate with `openssl rand -hex 32`.
JWT_SECRET=replace-with-32-or-more-random-characters
JWT_EXPIRES_IN=15m
JWT_ISSUER=boilerplate-nestjs
JWT_AUDIENCE=boilerplate-nestjs
REFRESH_TOKEN_TTL_SECONDS=604800

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Number of trusted reverse-proxy hops; 1 behind an ingress.
TRUST_PROXY_HOPS=0

# Comma-separated; no wildcard (credentials are enabled).
CORS_ORIGINS=http://localhost:5173

# Must be true in production and whenever COOKIE_SAMESITE=none.
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com
COOKIE_SAMESITE=lax

# Unset disables trace/metric export.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=boilerplate-nestjs
SERVICE_VERSION=0.0.0
